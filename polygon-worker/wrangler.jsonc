{
  "name": "polygon-worker",
  "main": "./src/index.js",
  "compatibility_date": "2024-01-01",
  "dev": {
    "port": 8788
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "env": {
    "local": {
      "vars": {
        "CLOUDFLARE_INCLUDE_PROCESS_ENV": true
      }
    },
    "production": {
    }
  }
}